# This key is used by the browser only to render Kakao Maps. Register the deployed domain in Kakao Developers.
VITE_KAKAO_MAP_KEY=

# Leave empty for local dev (Vite's dev proxy forwards /api to the local backend).
# When deploying the frontend separately from the backend (e.g. Vercel + Render),
# set this to the backend's public URL with no trailing slash,
# e.g. https://qroad-api.onrender.com
VITE_API_BASE_URL=
